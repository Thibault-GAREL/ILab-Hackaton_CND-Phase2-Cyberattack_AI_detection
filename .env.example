# Copier ce fichier vers `.env` et renseigner les valeurs.
# Le fichier `.env` est ignoré par Git (repo public).

# --- OpenSearch (FGAC Basic — hackathon CND) ---
OPENSEARCH_AUTH=basic
OPENSEARCH_BASIC_USER=etudiant
OPENSEARCH_BASIC_PASSWORD=

# Optionnel : domaine / index (defauts deja adaptes au hackathon dans config.py)
# OPENSEARCH_HOST=https://search-....eu-west-3.es.amazonaws.com
# OPENSEARCH_INDEX=logs-raw
# Curseur : file (defaut .opensearch_state.json) ou dynamodb (Lambda SAM)
# OPENSEARCH_STATE_BACKEND=file
# OPENSEARCH_STATE_BACKEND=dynamodb
# OPENSEARCH_STATE_DYNAMODB_TABLE=nom_table
# OPENSEARCH_STATE_DYNAMODB_PK=PIPELINE_CURSOR

# --- API de scoring (jour J) ---
# SCORING_API_URL=https://...
# SCORING_API_KEY=

# --- Bedrock (Claude Opus 4.6 — profil EU puis guide dans config.py) ---
# Forcer un seul modelId (sinon : eu.anthropic.claude-opus-4-6-v1 → anthropic.claude-opus-4-6-v1)
# BEDROCK_TIMELINE_MODEL_ID=eu.anthropic.claude-opus-4-6-v1
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-6-v1
# BEDROCK_REGION=eu-west-3
# BEDROCK_ENABLED=1
# Un appel Converse enrich + timeline (repli 2 appels si JSON invalide)
# BEDROCK_FUSED_CONVERSE=1
# BEDROCK_FUSED_MAX_TOKENS=6144
# Espacement entre appels + retries throttling
# BEDROCK_MIN_REQUEST_INTERVAL_S=0.75
# BEDROCK_THROTTLE_MAX_RETRIES=5
# Contexte OpenSearch agrégé pour le realtime (fenêtres attaque)
# BEDROCK_OS_CONTEXT_MAX_DOCS=100000
# BEDROCK_OS_CONTEXT_PAD_MINUTES=15
# Retirer les detections si enrichissement Bedrock confidence=low (faux positifs)
# BEDROCK_DROP_LOW_ENRICHMENT_CONFIDENCE=1
# IoC : noms de cles alignes ground-truth DS1 (desactiver en finale DS2 libre)
# CND_DS1_CANONICAL_IOCS=1
# AWS_PROFILE=entreprise
