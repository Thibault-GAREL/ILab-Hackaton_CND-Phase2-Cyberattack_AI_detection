# Configuration pour DIRISI 2025 Hackathon Backend

# === OpenSearch (pipeline lancée depuis l’API) ===
# Copier aussi la racine `.env.example` → `.env` ou définir sur ECS (voir docs/deployment.md).
# OPENSEARCH_AUTH=basic
# OPENSEARCH_BASIC_USER=etudiant
# OPENSEARCH_BASIC_PASSWORD=

# === Mode & Environnement ===
ENV=development
DEBUG=false

# === Modèle ===
# Options: rule, ml, hybrid
MODEL_MODE=rule

# === Seed pour reproductibilité ===
SEED=42

# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=false

# === Sécurité ===
# CORS : en plus de localhost:3000, origines supplémentaires (virgule)
# Ex. ECS (IP front) : CORS_ORIGINS=http://51.44.250.151:3000,http://ec2-51-44-250-151.eu-west-3.compute.amazonaws.com:3000
CORS_ORIGINS=

# Fichier detections (écrit par la pipeline lancée via POST /v1/detections/pipeline/run)
DETECTIONS_JSON_PATH=detections.json

# Autoriser la soumission live --submit (API scoring) depuis l'API ; défaut false en prod
PIPELINE_ALLOW_SUBMIT=0
# Rate limiting (requêtes par minute, 0 = désactivé)
RATE_LIMIT_PER_MIN=0

# === Logging ===
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Data Generation (pour /v1/ingest) ===
# Nombre de sites
DEFAULT_NUM_SITES=5
# Nombre de nœuds par site
DEFAULT_NODES_PER_SITE=3
# Durée simulation (minutes)
DEFAULT_DURATION_MIN=1440
# Fréquence métriques (minutes)
DEFAULT_FREQ_MIN=1
# Taux d'incidents (probabilité par nœud par période)
DEFAULT_INCIDENT_RATE=0.01

# === Seuils Modèle (règles) ===
THRESHOLD_CPU_HIGH=0.85
THRESHOLD_MEM_HIGH=0.90
THRESHOLD_IF_UTIL_HIGH=0.80
THRESHOLD_PKT_ERR_HIGH=0.05
THRESHOLD_LATENCY_HIGH_MS=100

# === Paths ===
DATA_DIR=./data
MODELS_DIR=./models
